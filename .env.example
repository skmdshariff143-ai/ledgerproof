# Copy to .env (never commit .env). The api npm scripts load it automatically.

# Runtime App database connection (Supabase Transaction Pooler on port 6543, or local Postgres).
# Deployed, it must connect as the restricted role ledgerproof_app (see db/roles.sql).
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledgerproof

# Direct database connection (Supabase Session/Direct port 5432) for DDL migrations (`npm run db:migrate`, `npm run seed`, `npm run db:bootstrap-admin`).
# Falls back to OWNER_DATABASE_URL or DATABASE_URL when unset.
# DIRECT_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# OWNER_DATABASE_URL=

# Test database. The name MUST end in _test: the tests wipe this database.
TEST_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledgerproof_test

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Secret guarding POST /api/system/bootstrap for First-Admin initialization when zero admins exist.
BOOTSTRAP_SECRET=

PORT=3000

# Browser origins allowed to read API responses (CORS), comma-separated, no trailing slash.
# Unset means no browser page can call the API. Local frontend: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
